# Metro's equivalent of Vite's import.meta.env. Copy to .env before building.
# These are inlined into the JS bundle at build time — publishable values only,
# never a service-role key or anything you would not ship inside an APK.
EXPO_PUBLIC_GO_BACKEND_URL=https://<your-railway-host>
EXPO_PUBLIC_WS_URL=wss://<your-railway-host>/ws
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
