# PickMe Go Backend environment
# Copy this file to backend/.env and fill in real values.
# Do not commit backend/.env.

# Required for startup
# Must include sslmode=require, sslmode=verify-full, or sslmode=verify-ca in
# the query string whenever APP_ENV is not development/dev/local — the
# backend fails to start otherwise. Example:
# postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Optional startup settings
PORT=3000
APP_ENV=production
READINESS_PROFILE=pilot
SUPABASE_JWT_AUDIENCE=authenticated
# If omitted, the backend derives this as ${SUPABASE_URL}/auth/v1.
SUPABASE_JWT_ISSUER=

# HTTP and CORS
# Required whenever APP_ENV is not development/dev/local — the backend fails
# to start without it (no production fallback). Replace with your real
# frontend origin(s) before deploying with APP_ENV=production or staging.
CORS_ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173
HTTP_REQUEST_TIMEOUT_SECONDS=15
HTTP_RATE_LIMIT_MAX=120
HTTP_RATE_LIMIT_WINDOW_SECONDS=60

# Scaling
# Leave at 1. This backend supports exactly one replica: the WebSocket
# driver/rider registries and the in-memory rate-limit fallback are
# per-process only. See docs/deployment/websocket-scaling.md before changing
# this. Setting it >1 does not enable clustering — it only logs a startup
# warning.
BACKEND_INSTANCE_COUNT=1

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Redis is optional.
# REDIS_URL is required only when REDIS_ENABLED=true.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=16
REDIS_DRIVER_LOCATION_TTL_SECONDS=60
REDIS_DRIVER_PRESENCE_TTL_SECONDS=90

# Asynq background jobs
# ASYNQ_REDIS_URL defaults to REDIS_URL when omitted.
ASYNQ_ENABLED=true
ASYNQ_REDIS_URL=redis://localhost:6379/1
ASYNQ_CONCURRENCY=10
ASYNQ_RETRY_MAX=5
ASYNQ_SHUTDOWN_TIMEOUT_SECONDS=30

# Notification platform
NOTIFICATION_RATE_LIMIT_PER_MINUTE=60
NOTIFICATION_FCM_ENDPOINT=
NOTIFICATION_FCM_TOKEN=
NOTIFICATION_SMS_ENDPOINT=
NOTIFICATION_SMS_TOKEN=
NOTIFICATION_EMAIL_ENDPOINT=
NOTIFICATION_EMAIL_TOKEN=

# Dispatch shadow mode
DISPATCH_MODE=authoritative
DISPATCH_SHADOW_RADIUS_KM=5
DISPATCH_SHADOW_CANDIDATE_LIMIT=20
DISPATCH_SHADOW_SELECTED_LIMIT=3
DISPATCH_SHADOW_RANKING_VERSION=v2.0-b-simple
DISPATCH_OFFER_TTL_SECONDS=30
DISPATCH_RIDE_LOCK_TTL_SECONDS=45
DISPATCH_DRIVER_LOCK_TTL_SECONDS=45
DISPATCH_QUEUE_NAME=dispatch:rides

# Wallet and settlement flags
WALLET_ACTIVE_SETTLEMENT_ENABLED=false
WALLET_ACTIVE_CASH_SETTLEMENT_ENABLED=false
WALLET_RIDE_AUTHORIZATION_ENABLED=false
WALLET_RIDE_AUTHORIZATION_TTL_MINUTES=30
WALLET_AUTHORIZATION_EXPIRATION_WORKER_ENABLED=false
WALLET_AUTHORIZATION_EXPIRATION_INTERVAL_SECONDS=60
WALLET_AUTHORIZATION_EXPIRATION_BATCH_LIMIT=100

# Internal wallet pilot
WALLET_INTERNAL_PILOT_ENABLED=false
WALLET_INTERNAL_PILOT_PERCENTAGE=0

# Public wallet pilot
PUBLIC_WALLET_PILOT_ENABLED=false
PUBLIC_WALLET_PILOT_PROGRAM_ID=
PUBLIC_WALLET_PILOT_CITY=Gwanda

# Payments master switch
PAYMENTS_PROVIDER_ENABLED=false

# OneMoney
# ONEMONEY_STATUS_URL is required outside development when ONEMONEY_ENABLED=true.
ONEMONEY_ENABLED=false
ONEMONEY_PILOT_ONLY=true
ONEMONEY_WEBHOOK_SECRET=
ONEMONEY_STATUS_URL=
ONEMONEY_STATUS_TOKEN=

# EcoCash
# ECOCASH_STATUS_URL is required outside development when ECOCASH_ENABLED=true.
ECOCASH_ENABLED=false
ECOCASH_PILOT_ONLY=true
ECOCASH_WEBHOOK_SECRET=
ECOCASH_STATUS_URL=
ECOCASH_STATUS_TOKEN=

# Innbucks
# INNBUCKS_STATUS_URL is required outside development when INNBUCKS_ENABLED=true.
INNBUCKS_ENABLED=false
INNBUCKS_PILOT_ONLY=true
INNBUCKS_WEBHOOK_SECRET=
INNBUCKS_STATUS_URL=
INNBUCKS_STATUS_TOKEN=

# PayPal
# PAYPAL_STATUS_URL is required outside development when PAYPAL_ENABLED=true.
PAYPAL_ENABLED=false
PAYPAL_PILOT_ONLY=true
PAYPAL_WEBHOOK_SECRET=
PAYPAL_STATUS_URL=
PAYPAL_STATUS_TOKEN=

# Card payments
# The current mock card processor is allowed only when APP_ENV is development, dev, or local.
CARD_PAYMENTS_ENABLED=false
CARD_PILOT_ONLY=true
