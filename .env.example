# Copy this file to `.env` and fill in values.
#
# IMPORTANT:
# - Only variables prefixed with `VITE_` are exposed to the browser.
# - `VITE_DD_RUM_CLIENT_TOKEN` is a public (browser) token.

# Datadog RUM
VITE_DD_RUM_ENABLED=false
VITE_DD_RUM_APPLICATION_ID=
VITE_DD_RUM_CLIENT_TOKEN=
VITE_DD_RUM_SITE=us5.datadoghq.com
VITE_DD_RUM_SERVICE=koloi-ride-with-confidence
VITE_DD_RUM_ENV=development
VITE_DD_RUM_VERSION=0.0.0

# Supabase client settings
# Use the publishable/anon key only. Never put service_role keys in frontend env.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Go backend API
# Preferred HTTP API base URL for the Go backend.
VITE_GO_BACKEND_URL=http://localhost:3000

# Go backend websocket endpoint. Keep this configured for realtime features;
# Phase 1 only unifies HTTP configuration and does not change websocket protocol.
VITE_WS_URL=ws://localhost:3000/ws

# Legacy HTTP aliases, supported for compatibility while older deployments migrate.
# Leave these empty unless your deployment platform already provides one of them.
VITE_API_BASE_URL=
VITE_BACKEND_URL=
VITE_API_URL=

# Mapbox public access token
VITE_MAPBOX_ACCESS_TOKEN=

# Docker image/runtime
IMAGE_TAG=local
APP_ENV=production
READINESS_PROFILE=pilot
FRONTEND_PORT=8080
BACKEND_PORT=3000

# Backend service secrets for docker-compose.
# Keep real values in .env on the server or in your deployment secret store.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
CORS_ALLOW_ORIGINS=https://pickme.example.com

# Redis and Asynq
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=16
ASYNQ_ENABLED=true
ASYNQ_REDIS_URL=redis://redis:6379/1
ASYNQ_CONCURRENCY=10
ASYNQ_WORKER_CONCURRENCY=10

# Dispatch
DISPATCH_MODE=authoritative
DISPATCH_QUEUE_NAME=dispatch:rides

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
LOKI_PORT=3100

# Notifications
NOTIFICATION_RATE_LIMIT_PER_MINUTE=60
NOTIFICATION_FCM_ENDPOINT=
NOTIFICATION_FCM_TOKEN=
NOTIFICATION_SMS_ENDPOINT=
NOTIFICATION_SMS_TOKEN=
NOTIFICATION_EMAIL_ENDPOINT=
NOTIFICATION_EMAIL_TOKEN=

# Pilot controls
PUBLIC_WALLET_PILOT_ENABLED=true
PUBLIC_WALLET_PILOT_CITY=Gwanda
PAYMENTS_PROVIDER_ENABLED=false
